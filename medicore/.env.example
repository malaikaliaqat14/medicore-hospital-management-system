# Django Secret Key (Generate a random string in production)
SECRET_KEY=django-insecure-change-this-in-production-example-key

# Debug Mode (Set False in Production)
DEBUG=True

# Allowed Hosts
ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL Database Connection URL: mysql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql://root:root123@localhost:3306/hms

# Redis Cache URL
REDIS_URL=redis://127.0.0.1:6379/0

# Amazon S3 Storage (Set True if using AWS S3 for media storage)
USE_S3=False
